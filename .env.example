# Skopiuj do .env i zmień wartości przed wystawieniem aplikacji w internet.
POSTGRES_PASSWORD=atlas
RABBITMQ_PASSWORD=atlas
# Min. 32 znaki. Ten sam klucz weryfikują wszystkie serwisy.
JWT_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef
# Token z panelu Cloudflare Zero Trust → Networks → Tunnels (tylko dla profilu "tunnel").
CLOUDFLARE_TUNNEL_TOKEN=
