{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "users",
        "Match": {
          "Path": "/api/users/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/users"
          }
        ]
      },
      "forum": {
        "ClusterId": "forum",
        "Match": {
          "Path": "/api/forum/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/forum"
          }
        ]
      },
      "map": {
        "ClusterId": "map",
        "Match": {
          "Path": "/api/map/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/map"
          }
        ]
      },
      "prediction": {
        "ClusterId": "prediction",
        "Match": {
          "Path": "/api/prediction/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/prediction"
          }
        ]
      },
      "frontend": {
        "ClusterId": "frontend",
        "Order": 1000,
        "Match": {
          "Path": "{**rest}"
        }
      }
    },
    "Clusters": {
      "users": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "forum": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "map": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5103/"
          }
        }
      },
      "prediction": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5104/"
          }
        }
      },
      "frontend": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5173/"
          }
        }
      }
    }
  }
}